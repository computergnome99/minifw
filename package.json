{
  "name": "@calvinbonner/minifw",
  "version": "0.0.1",
  "author": "Calvin Bonner <me@calvinbonner.com>",
  "type": "module",
  "description": "A simple, server-side framework for building hypermedia apps quickly with HTMX.",
  "license": "MIT",
  "repository": {},
  "bugs": {},
  "homepage": "https://www.calvinbonner.dev/demos/minifw",
  "keywords": [
    "htmx",
    "htmx4",
    "hypermedia",
    "bun",
    "typescript",
    "ts",
    "ssr",
    "framework"
  ],
  "files": [
    "lib",
    "!lib/**/*.spec.ts",
    "!lib/**/__fixtures__/**",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./core": "./lib/core/index.ts",
    "./helpers": "./lib/helpers/index.ts"
  },
  "scripts": {
    "test:unit": "bun test ./lib",
    "test:types": "tsc --noEmit",
    "test:e2e": "bun test ./examples/bun-routes/app.e2e.ts ./examples/express/app.e2e.ts ./examples/htmx-1/app.e2e.ts ./examples/htmx-2/app.e2e.ts ./examples/htmx-4/app.e2e.ts",
    "test:all": "bun run test:unit && bun run test:types && bun run test:e2e",
    "docs:build": "typedoc --options typedoc.json",
    "lint": "eslint --cache lib eslint.config.ts prettier.config.ts ; prettier --check .",
    "lint:fix": "eslint --cache lib eslint.config.ts prettier.config.ts --fix ; prettier --write .",
    "prepare": "husky",
    "run:bun-routes": "bun examples/bun-routes/server.ts",
    "run:express": "node --import tsx examples/express/server.ts",
    "run:htmx-1": "bun examples/htmx-1/server.ts",
    "run:htmx-2": "bun examples/htmx-2/server.ts",
    "run:htmx-4": "bun examples/htmx-4/server.ts"
  },
  "dependencies": {
    "html-minifier-terser": "^7.2",
    "lightningcss": "^1.32.0",
    "linkedom": "^0.18.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/html-minifier-terser": "^7.0.2",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-prettier": "^5.5",
    "eslint-plugin-unicorn": "^73.0.0",
    "express": "^5.2.1",
    "htmx-1": "npm:htmx.org@1.9.12",
    "htmx-2": "npm:htmx.org@2.0.4",
    "htmx-4": "npm:htmx.org@4.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3",
    "prettier-plugin-jsdoc": "^1.8",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "bun": "^1.4"
  }
}
